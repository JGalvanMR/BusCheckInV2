<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:views="clr-namespace:BusCheckInV2.Views"
       x:Class="BusCheckInV2.AppShell"
       Title="BusCheckInV2"
       Shell.FlyoutBehavior="Disabled">

    <!--  Página principal: Selección de Flete  -->
    <ShellContent x:Name="shellSeleccionDeFlete"
                  Title="Seleccionar Flete"
                  ContentTemplate="{DataTemplate views:SeleccionDeFlete}"
                  Route="selecciondeflete"
                  Icon="home.png" />

    <!--  Página de Escaneo de Código  -->
    <ShellContent x:Name="shellEscaneoCodigo"
                  Title="Escanear Código"
                  ContentTemplate="{DataTemplate views:EscaneoCodigo}"
                  Route="escaneocodigo"
                  Icon="scan.png" />

    <!--  Página de Fletes Pendientes (no visible en tabs)  -->
    <ShellContent x:Name="shellFletesPendientes"
                  Title="Fletes Pendientes"
                  ContentTemplate="{DataTemplate views:FletesPendientes}"
                  Route="fletespendientes"
                  IsVisible="False" />
</Shell>