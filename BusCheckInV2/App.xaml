<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:BusCheckInV2.Converters"
             x:Class="BusCheckInV2.App">
    <Application.Resources>
        <ResourceDictionary>
            <converters:IntToBoolConverter x:Key="IntToBoolConverter" />
            <converters:StatusToColorConverter x:Key="StatusToColorConverter" />
            <converters:AnonymizeConverter x:Key="AnonymizeConverter" />
            <converters:CountToHeightConverter x:Key="CountToHeightConverter" />
            <converters:ConnectionColorConverter x:Key="ConnectionColorConverter" />
            <converters:ConnectionStatusConverter x:Key="ConnectionStatusConverter" />

            <converters:StatusToActionConverter x:Key="StatusToActionConverter" />
            <converters:InverseIntToBoolConverter x:Key="InverseIntToBoolConverter" />

            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
