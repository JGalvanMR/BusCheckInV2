<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup
    x:Class="BusCheckInV2.Views.Popups.FleteDetallePopup"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:converters="clr-namespace:BusCheckInV2.Converters"
    xmlns:toolkit="clr-namespace:CommunityToolkit.Maui.Views;assembly=CommunityToolkit.Maui"
    xmlns:vm="clr-namespace:BusCheckInV2.ViewModels.Popups"
    x:DataType="vm:FleteDetallePopupViewModel"
    Background="Transparent"
    CanBeDismissedByTappingOutsideOfPopup="True"
    HorizontalOptions="Center"
    VerticalOptions="Center">

    <toolkit:Popup.Resources>
        <ResourceDictionary>
            <converters:StatusToColorConverter x:Key="StatusToColorConverter" />

            <!--  Paleta principal  -->
            <Color x:Key="PrimaryColor">#007AFF</Color>
            <Color x:Key="PrimaryDarkColor">#30B0C7</Color>
            <Color x:Key="AccentColor">#FF9500</Color>
            <Color x:Key="SurfaceLight">#FFFFFF</Color>
            <Color x:Key="SurfaceDark">#1A1B23</Color>
            <Color x:Key="SurfaceVariantLight">#F8FAFC</Color>
            <Color x:Key="SurfaceVariantDark">#25272F</Color>
            <Color x:Key="OutlineLight">#E5E7EB</Color>
            <Color x:Key="OutlineDark">#2F313A</Color>
            <Color x:Key="TextPrimaryLight">#0F172A</Color>
            <Color x:Key="TextPrimaryDark">#F1F5F9</Color>
            <Color x:Key="TextSecondaryLight">#64748B</Color>
            <Color x:Key="TextSecondaryDark">#94A3B8</Color>

            <Style x:Key="CardBorder" TargetType="Border">
                <Setter Property="Padding" Value="0" />
                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}" />
                <Setter Property="StrokeThickness" Value="0" />
                <Setter Property="Stroke" Value="Transparent" />
                <Setter Property="StrokeShape">
                    <Setter.Value>
                        <RoundRectangle CornerRadius="24" />
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="FieldChip" TargetType="Border">
                <Setter Property="Padding" Value="12,10" />
                <Setter Property="StrokeThickness" Value="1" />
                <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource OutlineLight}, Dark={StaticResource OutlineDark}}" />
                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceVariantLight}, Dark={StaticResource SurfaceVariantDark}}" />
                <Setter Property="StrokeShape">
                    <Setter.Value>
                        <RoundRectangle CornerRadius="14" />
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="FieldLabel" TargetType="Label">
                <Setter Property="FontSize" Value="10" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="CharacterSpacing" Value="1.5" />
                <Setter Property="TextTransform" Value="Uppercase" />
                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
            </Style>

            <Style x:Key="TonalButton" TargetType="Button">
                <Setter Property="CornerRadius" Value="22" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="Padding" Value="12,8" />
                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#E0E7FF, Dark=#1E3A8A}" />
                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource PrimaryDarkColor}, Dark=#C7D2FE}" />
            </Style>
        </ResourceDictionary>
    </toolkit:Popup.Resources>

    <!--  Tarjeta flotante  -->
    <Border
        HorizontalOptions="Center"
        Style="{StaticResource CardBorder}"
        VerticalOptions="Center"
        WidthRequest="320">
        <Border.Shadow>
            <Shadow
                Opacity="0.25"
                Radius="24"
                Offset="0,8" />
        </Border.Shadow>

        <Grid RowDefinitions="Auto,Auto,*">

            <!--  HEADER  -->
            <Grid Grid.Row="0" HeightRequest="100">
                <BoxView Color="{StaticResource PrimaryColor}" />
                <BoxView Opacity="0.85" Color="{StaticResource AccentColor}" />
                <Label
                    Margin="0,-10,-10,0"
                    FontSize="80"
                    HorizontalOptions="End"
                    Opacity="0.18"
                    Text="🚍"
                    TextColor="White"
                    VerticalOptions="Start" />
                <VerticalStackLayout
                    Padding="24,18,24,18"
                    Spacing="2"
                    VerticalOptions="Center">
                    <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                        <Border
                            Padding="6,3"
                            BackgroundColor="#33FFFFFF"
                            StrokeThickness="0"
                            VerticalOptions="Center">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8" />
                            </Border.StrokeShape>
                            <Label
                                FontAttributes="Bold"
                                FontSize="10"
                                Text="FOLIO"
                                TextColor="White" />
                        </Border>
                        <Label
                            FontAttributes="Bold"
                            FontSize="13"
                            Text="{Binding Flete.IdFletePer, FallbackValue='N/A'}"
                            TextColor="White"
                            VerticalOptions="Center" />
                    </HorizontalStackLayout>
                    <Label
                        FontAttributes="Bold"
                        FontSize="22"
                        Text="Detalle del Flete"
                        TextColor="White" />
                </VerticalStackLayout>
            </Grid>

            <!--  BADGE DE ESTADO  -->
            <Border
                Grid.Row="0"
                Margin="0,70,20,0"
                Padding="14,6"
                BackgroundColor="{Binding Flete.Estatus, Converter={StaticResource StatusToColorConverter}}"
                HorizontalOptions="End"
                StrokeThickness="0"
                VerticalOptions="Start">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16" />
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow
                        Opacity="0.35"
                        Radius="8"
                        Offset="0,4" />
                </Border.Shadow>
                <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                    <Ellipse
                        Fill="White"
                        HeightRequest="6"
                        WidthRequest="6" />
                    <Label
                        FontAttributes="Bold"
                        FontSize="11"
                        Text="{Binding Flete.Estatus}"
                        TextColor="White" />
                </HorizontalStackLayout>
            </Border>

            <!--  CONTENIDO  -->
            <ScrollView Grid.Row="2" Padding="0">
                <VerticalStackLayout Padding="20,16,20,16" Spacing="14">

                    <!--  Ruta  -->
                    <Border Style="{StaticResource FieldChip}">
                        <VerticalStackLayout Spacing="10">
                            <HorizontalStackLayout Spacing="10">
                                <Label
                                    FontSize="16"
                                    Text="🗺️"
                                    VerticalOptions="Center" />
                                <Label
                                    Style="{StaticResource FieldLabel}"
                                    Text="Ruta"
                                    VerticalOptions="Center" />
                            </HorizontalStackLayout>
                            <Label
                                FontAttributes="Bold"
                                FontSize="15"
                                LineBreakMode="WordWrap"
                                Text="{Binding Flete.Ruta}"
                                TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight},
                                                            Dark={StaticResource TextPrimaryDark}}" />
                        </VerticalStackLayout>
                    </Border>

                    <!--  Grid 2x2  -->
                    <Grid
                        ColumnDefinitions="*,*"
                        ColumnSpacing="12"
                        RowDefinitions="Auto,Auto"
                        RowSpacing="12">
                        <!--  Fecha/Hora  -->
                        <Border
                            Grid.Row="0"
                            Grid.Column="0"
                            Style="{StaticResource FieldChip}">
                            <VerticalStackLayout Spacing="6">
                                <HorizontalStackLayout Spacing="6">
                                    <Label
                                        FontSize="13"
                                        Text="📅"
                                        VerticalOptions="Center" />
                                    <Label
                                        Style="{StaticResource FieldLabel}"
                                        Text="Fecha/Hora"
                                        VerticalOptions="Center" />
                                </HorizontalStackLayout>
                                <Label
                                    FontAttributes="Bold"
                                    FontSize="13"
                                    Text="{Binding Flete.FechaHora, StringFormat='{0:dd/MM/yyyy HH:mm}'}"
                                    TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight},
                                                                Dark={StaticResource TextPrimaryDark}}" />
                            </VerticalStackLayout>
                        </Border>

                        <!--  Duración  -->
                        <Border
                            Grid.Row="0"
                            Grid.Column="1"
                            Style="{StaticResource FieldChip}">
                            <VerticalStackLayout Spacing="6">
                                <HorizontalStackLayout Spacing="6">
                                    <Label
                                        FontSize="13"
                                        Text="⏱️"
                                        VerticalOptions="Center" />
                                    <Label
                                        Style="{StaticResource FieldLabel}"
                                        Text="Duración"
                                        VerticalOptions="Center" />
                                </HorizontalStackLayout>
                                <Label
                                    FontAttributes="Bold"
                                    FontSize="13"
                                    Text="{Binding DuracionViaje}"
                                    TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight},
                                                                Dark={StaticResource TextPrimaryDark}}" />
                            </VerticalStackLayout>
                        </Border>

                        <!--  Chofer  -->
                        <Border
                            Grid.Row="1"
                            Grid.Column="0"
                            Style="{StaticResource FieldChip}">
                            <VerticalStackLayout Spacing="6">
                                <HorizontalStackLayout Spacing="6">
                                    <Label
                                        FontSize="13"
                                        Text="👤"
                                        VerticalOptions="Center" />
                                    <Label
                                        Style="{StaticResource FieldLabel}"
                                        Text="Chofer"
                                        VerticalOptions="Center" />
                                </HorizontalStackLayout>
                                <Label
                                    FontAttributes="Bold"
                                    FontSize="13"
                                    LineBreakMode="WordWrap"
                                    Text="{Binding Flete.Chofer}"
                                    TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight},
                                                                Dark={StaticResource TextPrimaryDark}}" />
                            </VerticalStackLayout>
                        </Border>

                        <!--  Proveedor  -->
                        <Border
                            Grid.Row="1"
                            Grid.Column="1"
                            Style="{StaticResource FieldChip}">
                            <VerticalStackLayout Spacing="6">
                                <HorizontalStackLayout Spacing="6">
                                    <Label
                                        FontSize="13"
                                        Text="🏢"
                                        VerticalOptions="Center" />
                                    <Label
                                        Style="{StaticResource FieldLabel}"
                                        Text="Proveedor"
                                        VerticalOptions="Center" />
                                </HorizontalStackLayout>
                                <Label
                                    FontAttributes="Bold"
                                    FontSize="13"
                                    LineBreakMode="WordWrap"
                                    Text="{Binding Flete.Proveedor}"
                                    TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight},
                                                                Dark={StaticResource TextPrimaryDark}}" />
                            </VerticalStackLayout>
                        </Border>
                    </Grid>

                    <!--  Tipo de Flete  -->
                    <Border Style="{StaticResource FieldChip}">
                        <HorizontalStackLayout Spacing="12">
                            <Label
                                FontSize="18"
                                Text="📦"
                                VerticalOptions="Center" />
                            <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                                <Label Style="{StaticResource FieldLabel}" Text="Tipo de Flete" />
                                <Label
                                    FontAttributes="Bold"
                                    FontSize="13"
                                    LineBreakMode="WordWrap"
                                    Text="{Binding TipoCompleto}"
                                    TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight},
                                                                Dark={StaticResource TextPrimaryDark}}" />
                            </VerticalStackLayout>
                        </HorizontalStackLayout>
                    </Border>

                    <!--  Pasajeros  -->
                    <Border Style="{StaticResource FieldChip}">
                        <VerticalStackLayout Spacing="10">
                            <HorizontalStackLayout Spacing="8">
                                <Label
                                    FontSize="16"
                                    Text="🧳"
                                    VerticalOptions="Center" />
                                <Label
                                    Style="{StaticResource FieldLabel}"
                                    Text="Pasajeros"
                                    VerticalOptions="Center" />
                            </HorizontalStackLayout>
                            <HorizontalStackLayout Spacing="14" VerticalOptions="Center">
                                <VerticalStackLayout Spacing="0" VerticalOptions="Center">
                                    <Label
                                        FontSize="10"
                                        Text="ESPERADOS"
                                        TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight},
                                                                    Dark={StaticResource TextSecondaryDark}}" />
                                    <Label
                                        FontAttributes="Bold"
                                        FontSize="22"
                                        Text="{Binding Flete.CantidadEsperada}"
                                        TextColor="{StaticResource AccentColor}" />
                                </VerticalStackLayout>
                                <BoxView
                                    BackgroundColor="{AppThemeBinding Light={StaticResource OutlineLight},
                                                                      Dark={StaticResource OutlineDark}}"
                                    HeightRequest="36"
                                    WidthRequest="1" />
                                <VerticalStackLayout Spacing="0" VerticalOptions="Center">
                                    <Label
                                        FontSize="10"
                                        Text="REALES"
                                        TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight},
                                                                    Dark={StaticResource TextSecondaryDark}}" />
                                    <HorizontalStackLayout Spacing="2">
                                        <Label
                                            FontAttributes="Bold"
                                            FontSize="22"
                                            Text="{Binding Flete.CantidadReal}"
                                            TextColor="{StaticResource PrimaryColor}" />
                                        <Label
                                            FontSize="13"
                                            Text="👥"
                                            VerticalOptions="End" />
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <!--  Botón cerrar  -->
                    <Button
                        Command="{Binding CerrarCommand}"
                        HorizontalOptions="Center"
                        Style="{StaticResource TonalButton}"
                        Text="Cerrar"
                        WidthRequest="140" />

                </VerticalStackLayout>
            </ScrollView>

        </Grid>
    </Border>
</toolkit:Popup>