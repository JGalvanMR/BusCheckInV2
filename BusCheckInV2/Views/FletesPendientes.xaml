<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="BusCheckInV2.Views.FletesPendientes"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:converters="clr-namespace:BusCheckInV2.Converters"
    xmlns:helpers="clr-namespace:BusCheckInV2.Helpers"
    xmlns:models="clr-namespace:BusCheckInV2.Models"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:viewmodels="clr-namespace:BusCheckInV2.ViewModels"
    Title="Fletes Pendientes"
    x:DataType="viewmodels:FletesPendientesViewModel"
    BackgroundColor="{AppThemeBinding Light=#F5F7FA,
                                      Dark=#121212}"
    Shell.NavBarIsVisible="True">

    <!--  ===================== RESOURCES =====================  -->
    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:StatusToColorConverter x:Key="StatusToColorConverter" />
            <converters:IntToBoolConverter x:Key="IntToBoolConverter" />
            <converters:InverseIntToBoolConverter x:Key="InverseIntToBoolConverter" />

            <Style x:Key="CardBorder" TargetType="Border">
                <Setter Property="Padding" Value="12" />
                <Setter Property="Margin" Value="8,4" />
                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=White, Dark=#1E1E1E}" />
                <Setter Property="StrokeThickness" Value="0" />
                <Setter Property="StrokeShape">
                    <Setter.Value>
                        <RoundRectangle CornerRadius="14" />
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="TonalButton" TargetType="Button">
                <Setter Property="CornerRadius" Value="20" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Padding" Value="7,5" />
                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#E3F2FD, Dark=#263238}" />
                <Setter Property="TextColor" Value="{AppThemeBinding Light=#0D47A1, Dark=#BBDEFB}" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <!--  ===================== TOOLBAR =====================  -->
    <Shell.BackButtonBehavior>
        <BackButtonBehavior IsEnabled="False" IsVisible="False" />
    </Shell.BackButtonBehavior>

    <ContentPage.ToolbarItems>
        <ToolbarItem
            Command="{Binding VolverCommand}"
            Order="Primary"
            Priority="0"
            Text="Volver">
            <ToolbarItem.IconImageSource>
                <FontImageSource
                    FontFamily="FontAwesome"
                    Glyph="{x:Static helpers:IconFont.ArrowLeft}"
                    Size="24"
                    Color="{AppThemeBinding Light=#212121,
                                            Dark=White}" />
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
    </ContentPage.ToolbarItems>

    <!--  ===================== LAYOUT ROOT =====================  -->
    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">

        <!--  ===================== FILTROS =====================  -->
        <VerticalStackLayout
            Grid.Row="0"
            Padding="0"
            Spacing="8">
            <Border Padding="12" Style="{StaticResource CardBorder}">
                <Border.Shadow>
                    <Shadow
                        Opacity="0.18"
                        Radius="12"
                        Offset="0,4" />
                </Border.Shadow>

                <Grid
                    ColumnDefinitions="Auto,*"
                    ColumnSpacing="8"
                    RowDefinitions="Auto,Auto,Auto,Auto"
                    RowSpacing="6">

                    <!--  Fila 0: Etiqueta Chofer + Indicador de conexión  -->
                    <Label
                        Grid.Row="0"
                        Grid.Column="0"
                        FontAttributes="Bold"
                        FontSize="14"
                        Text="Chofer" />

                    <!--  ─── FIX: TextoEstadoConexion y ColorEstadoConexion ───  -->
                    <!--  Antes: Text="{Binding TextoEstadoConexion}"  -->
                    <!--  TextColor="{Binding ColorEstadoConexion}"  -->
                    <!--  Ahora: ambas propiedades existen en el ViewModel  -->
                    <Label
                        Grid.Row="0"
                        Grid.Column="1"
                        FontSize="11"
                        HorizontalTextAlignment="End"
                        Text="{Binding TextoEstadoConexion}"
                        TextColor="{Binding ColorEstadoConexion}" />

                    <!--  Fila 1: Picker de Chofer  -->
                    <!--  ─── FIX: SelectedItem usa UsuarioSeleccionado ────────  -->
                    <!--  Antes: SelectedItem="{Binding UsuarioSeleccionado}"  -->
                    <!--  (propiedad inexistente)  -->
                    <!--  Ahora: UsuarioSeleccionado existe en el ViewModel  -->
                    <!--  y es de tipo UsuarioApi (mismo tipo que la  -->
                    <!--  colección ListaUsuarios)  -->
                    <Picker
                        Title="Seleccionar chofer"
                        Grid.Row="1"
                        Grid.Column="0"
                        Grid.ColumnSpan="2"
                        HeightRequest="44"
                        ItemDisplayBinding="{Binding Nombre}"
                        ItemsSource="{Binding ListaUsuarios}"
                        SelectedItem="{Binding UsuarioSeleccionado}" />

                    <!--  Fila 2: Switch solo pendientes + días filtro  -->
                    <HorizontalStackLayout
                        Grid.Row="2"
                        Grid.Column="0"
                        Grid.ColumnSpan="2"
                        Spacing="10"
                        VerticalOptions="Center">
                        <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                            <Switch IsToggled="{Binding MostrarSoloPendientes}" Scale="0.9" />
                            <Label
                                FontSize="12"
                                Text="Solo pendientes"
                                VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        <Label
                            FontSize="11"
                            Text="{Binding DiasFiltro, StringFormat='Últimos {0} días'}"
                            TextColor="Gray"
                            VerticalOptions="Center" />
                    </HorizontalStackLayout>

                    <!--  Fila 3: Botón Actualizar  -->
                    <!--  ─── FIX: CargarFletesComando → CargarFletesPendientesCommand  -->
                    <Button
                        Grid.Row="3"
                        Grid.Column="0"
                        Grid.ColumnSpan="2"
                        Padding="12,0"
                        Command="{Binding CargarFletesPendientesCommand}"
                        FontSize="13"
                        HeightRequest="44"
                        Style="{StaticResource TonalButton}"
                        Text="Actualizar" />

                </Grid>
            </Border>
        </VerticalStackLayout>

        <!--  Mensaje de estado  -->
        <Label
            Grid.Row="2"
            Margin="10,5"
            FontSize="12"
            HorizontalOptions="Center"
            Text="{Binding MensajeEstado}"
            TextColor="Gray"
            VerticalOptions="Start" />

        <!--  ===================== LISTA DE FLETES =====================  -->
        <!--  ─── FIX: CargarFletesComando → CargarFletesPendientesCommand  -->
        <RefreshView
            Grid.Row="3"
            Command="{Binding CargarFletesPendientesCommand}"
            IsRefreshing="{Binding EstaCargando}">

            <CollectionView ItemsSource="{Binding FletesPendientes}" SelectionMode="None">

                <CollectionView.EmptyView>
                    <VerticalStackLayout
                        Padding="40"
                        HorizontalOptions="Center"
                        Spacing="20"
                        VerticalOptions="Center">
                        <Label
                            FontSize="40"
                            HorizontalOptions="Center"
                            Text="📭" />
                        <Label
                            FontSize="16"
                            HorizontalOptions="Center"
                            Text="{Binding MensajeEstado}"
                            TextColor="Gray" />
                        <Label
                            FontSize="12"
                            HorizontalOptions="Center"
                            Text="Seleccione un chofer para comenzar"
                            TextColor="LightGray" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <!--  x:DataType en el DataTemplate para binding fuerte en items  -->
                    <DataTemplate x:DataType="models:FletePendienteUI">
                        <Border Style="{StaticResource CardBorder}">
                            <Border.Shadow>
                                <Shadow
                                    Opacity="0.12"
                                    Radius="8"
                                    Offset="0,2" />
                            </Border.Shadow>

                            <Grid
                                ColumnDefinitions="*,Auto"
                                RowDefinitions="Auto,Auto,Auto"
                                RowSpacing="8">

                                <!--  Fila 0: Ruta y Fecha  -->
                                <VerticalStackLayout Grid.Row="0" Grid.Column="0">
                                    <Label
                                        FontAttributes="Bold"
                                        FontSize="16"
                                        LineBreakMode="WordWrap"
                                        Text="{Binding Ruta}" />
                                    <Label
                                        FontSize="12"
                                        Text="{Binding FechaHora, StringFormat='{0:dd/MM/yyyy HH:mm}'}"
                                        TextColor="Gray" />
                                </VerticalStackLayout>

                                <Grid
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    ColumnDefinitions="Auto,Auto">
                                    <Label
                                        Grid.Column="0"
                                        FontAttributes="Bold"
                                        FontSize="16"
                                        Text="👥  "
                                        TextColor="Gray" />
                                    <Label
                                        Grid.Column="1"
                                        FontAttributes="Bold"
                                        FontSize="16"
                                        Text="{Binding CantidadEsperada}" />
                                </Grid>

                                <!--  Fila 1: Chofer y Estado  -->
                                <Grid
                                    Grid.Row="1"
                                    Grid.ColumnSpan="2"
                                    ColumnDefinitions="*,Auto">
                                    <Label
                                        Grid.Column="0"
                                        FontSize="14"
                                        Text="{Binding Chofer}" />
                                    <Border
                                        Grid.Column="1"
                                        Padding="8,4"
                                        BackgroundColor="{Binding Estatus, Converter={StaticResource StatusToColorConverter}}">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="16" />
                                        </Border.StrokeShape>
                                        <Label
                                            FontAttributes="Bold"
                                            FontSize="11"
                                            Text="{Binding Estatus}"
                                            TextColor="White" />
                                    </Border>
                                </Grid>

                                <!--  Fila 2: Botones  -->
                                <Grid
                                    Grid.Row="2"
                                    Grid.ColumnSpan="2"
                                    ColumnDefinitions="*,*"
                                    ColumnSpacing="5">

                                    <!--  ─── FIX: VerDetalleComando → VerDetalleFleteCommand  -->
                                    <Button
                                        Grid.Column="0"
                                        BackgroundColor="Transparent"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.VerDetalleFleteCommand}"
                                        CommandParameter="{Binding .}"
                                        CornerRadius="20"
                                        Text="Detalle"
                                        TextColor="#2196F3" />

                                    <!--  ─── FIX: ValidarYFinalizarComando → ValidarYFinalizarFleteCommand  -->
                                    <Button
                                        Grid.Column="1"
                                        BackgroundColor="#4CAF50"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.ValidarYFinalizarFleteCommand}"
                                        CommandParameter="{Binding .}"
                                        CornerRadius="20"
                                        IsVisible="{Binding EsPendiente}"
                                        Text="Finalizar"
                                        TextColor="White" />
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

        <!--  ===================== FOOTER =====================  -->
        <Border Grid.Row="4" Style="{StaticResource CardBorder}">
            <Border.Shadow>
                <Shadow
                    Opacity="0.12"
                    Radius="8"
                    Offset="0,2" />
            </Border.Shadow>

            <Grid
                ColumnDefinitions="Auto,*"
                ColumnSpacing="8"
                VerticalOptions="Center">

                <Label
                    FontSize="13"
                    Text="{Binding FletesPendientes.Count, StringFormat='{0} fletes'}"
                    TextColor="Gray"
                    VerticalOptions="Center" />

                <!--  ─── FIX: SincronizarComando → SincronizarCommand ────  -->
                <Button
                    Grid.Column="1"
                    Command="{Binding SincronizarCommand}"
                    Style="{StaticResource TonalButton}"
                    Text="Sincronizar" />
            </Grid>
        </Border>

        <!--  ActivityIndicator  -->
        <ActivityIndicator
            Grid.RowSpan="5"
            HorizontalOptions="Center"
            IsRunning="{Binding EstaCargando}"
            IsVisible="{Binding EstaCargando}"
            Scale="1.6"
            VerticalOptions="Center"
            Color="#2196F3" />
    </Grid>
</ContentPage>