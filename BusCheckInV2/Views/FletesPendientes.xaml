<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="BusCheckInV2.Views.FletesPendientes"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:converters="clr-namespace:BusCheckInV2.Converters"
    xmlns:helpers="clr-namespace:BusCheckInV2.Helpers"
    xmlns:models="clr-namespace:BusCheckInV2.Models"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:viewmodels="clr-namespace:BusCheckInV2.ViewModels"
    Title="Fletes Pendientes"
    x:DataType="viewmodels:FletesPendientesViewModel"
    BackgroundColor="{AppThemeBinding Light=#F5F7FA,
                                      Dark=#121212}"
    Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:StatusToColorConverter x:Key="StatusToColorConverter" />
            <converters:IntToBoolConverter x:Key="IntToBoolConverter" />
            <converters:InverseIntToBoolConverter x:Key="InverseIntToBoolConverter" />

            <Style x:Key="CardBorder" TargetType="Border">
                <Setter Property="Padding" Value="12" />
                <Setter Property="Margin" Value="8,4" />
                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=White, Dark=#1E1E1E}" />
                <Setter Property="StrokeThickness" Value="0" />
                <Setter Property="StrokeShape">
                    <Setter.Value>
                        <RoundRectangle CornerRadius="14" />
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="ActionFlatButton" TargetType="Button">
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="HeightRequest" Value="40" />
                <Setter Property="VerticalOptions" Value="Center" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <!--  Toolbar oculto para el botón de atrás  -->
    <Shell.BackButtonBehavior>
        <BackButtonBehavior IsEnabled="False" IsVisible="true" />
    </Shell.BackButtonBehavior>
    <ContentPage.ToolbarItems>
        <ToolbarItem
            Command="{Binding VolverCommand}"
            Order="Primary"
            Priority="0"
            Text="Volver">
            <ToolbarItem.IconImageSource>
                <FontImageSource
                    FontFamily="FontAwesome"
                    Glyph="{x:Static helpers:IconFont.ArrowLeft}"
                    Size="24"
                    Color="White" />
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
    </ContentPage.ToolbarItems>

    <!--  CORREGIDO: Grid con 6 filas bien definidas en lugar de las 4 mal organizadas de la versión vieja  -->
    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">

        <!--  ════════════ FILA 1: ESTADO DE CONEXIÓN ════════════  -->
        <Border
            Grid.Row="0"
            Margin="8,4"
            Style="{StaticResource CardBorder}">
            <Border.Shadow>
                <Shadow
                    Opacity="0.1"
                    Radius="8"
                    Offset="0,2" />
            </Border.Shadow>
            <Grid ColumnDefinitions="Auto,*,Auto" VerticalOptions="Center">
                <Label
                    Grid.Column="0"
                    Margin="0,0,8,0"
                    FontSize="18"
                    Text="🌐"
                    VerticalOptions="Center" />
                <Label
                    Grid.Column="1"
                    FontAttributes="Bold"
                    FontSize="13"
                    Text="{Binding TextoEstadoConexion}"
                    TextColor="{Binding ColorEstadoConexion}"
                    VerticalOptions="Center" />

                <!--  RECUPERADO: Botón de probar conexión  -->
                <Button
                    Grid.Column="2"
                    Padding="5"
                    BackgroundColor="Transparent"
                    Command="{Binding ProbarConexionCommand}"
                    FontSize="12"
                    Text="🔁 Probar"
                    TextColor="{Binding ColorEstadoConexion}" />
            </Grid>
        </Border>

        <!--  ════════════ FILA 2: SELECTOR DE CHOFER ════════════  -->
        <Border Grid.Row="1" Style="{StaticResource CardBorder}">
            <VerticalStackLayout Spacing="6">
                <Label
                    FontAttributes="Bold"
                    FontSize="14"
                    Text="Seleccionar Chofer:" />
                <Picker
                    Title="👤 Elige tu nombre"
                    HeightRequest="44"
                    ItemDisplayBinding="{Binding Nombre}"
                    ItemsSource="{Binding ListaUsuarios}"
                    SelectedItem="{Binding UsuarioSeleccionado}" />
            </VerticalStackLayout>
        </Border>

        <!--  ════════════ FILA 3: FILTROS ════════════  -->
        <Border Grid.Row="2" Style="{StaticResource CardBorder}">
            <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                <VerticalStackLayout Grid.Column="0" Spacing="4">
                    <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                        <Switch
                            IsToggled="{Binding MostrarSoloPendientes}"
                            OnColor="#4CAF50"
                            Scale="0.9" />
                        <Label
                            FontSize="13"
                            Text="Solo pendientes"
                            VerticalOptions="Center" />
                    </HorizontalStackLayout>
                    <Label
                        FontSize="11"
                        Text="{Binding DiasFiltro, StringFormat='Mostrando últimos {0} días'}"
                        TextColor="Gray" />
                </VerticalStackLayout>
                <Button
                    Grid.Column="1"
                    BackgroundColor="#E0E0E0"
                    Command="{Binding CargarFletesPendientesCommand}"
                    CornerRadius="25"
                    FontSize="18"
                    HeightRequest="44"
                    Text="🔄"
                    WidthRequest="44" />
            </Grid>
        </Border>

        <!--  ════════════ FILA 4: LISTA DE FLETES ════════════  -->
        <RefreshView
            Grid.Row="3"
            Command="{Binding CargarFletesPendientesCommand}"
            IsRefreshing="{Binding EstaCargando, Mode=OneWay}">
            <CollectionView ItemsSource="{Binding FletesPendientes}" SelectionMode="None">
                <CollectionView.EmptyView>
                    <VerticalStackLayout
                        Padding="40"
                        HorizontalOptions="Center"
                        Spacing="20"
                        VerticalOptions="Center">
                        <Label
                            FontSize="50"
                            HorizontalOptions="Center"
                            Text="📭" />
                        <Label
                            FontSize="16"
                            HorizontalOptions="Center"
                            Text="{Binding MensajeEstado}"
                            TextColor="Gray" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:FletePendienteUI">
                        <Border Style="{StaticResource CardBorder}">
                            <Border.Shadow>
                                <Shadow
                                    Opacity="0.12"
                                    Radius="8"
                                    Offset="0,2" />
                            </Border.Shadow>

                            <!--  Grid interno de 8 filas para simular la versión vieja pero sin bugs  -->
                            <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="6">

                                <!--  0: Cabecera Ruta y Estado  -->
                                <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                                    <Label
                                        Grid.Column="0"
                                        FontAttributes="Bold"
                                        FontSize="16"
                                        LineBreakMode="WordWrap"
                                        Text="{Binding Ruta}"
                                        VerticalOptions="Center" />
                                    <Border
                                        Grid.Column="1"
                                        Padding="8,4"
                                        BackgroundColor="{Binding Estatus, Converter={StaticResource StatusToColorConverter}}"
                                        StrokeShape="RoundRectangle 12"
                                        VerticalOptions="Center">
                                        <Label
                                            FontAttributes="Bold"
                                            FontSize="11"
                                            Text="{Binding Estatus}"
                                            TextColor="White" />
                                    </Border>
                                </Grid>

                                <!--  1: Separador  -->
                                <BoxView
                                    Grid.Row="1"
                                    Margin="0,2"
                                    BackgroundColor="#E0E0E0"
                                    HeightRequest="1" />

                                <!--  2: Info Chofer  -->
                                <Label Grid.Row="2" FontSize="13">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="👤 Chofer: " TextColor="Gray" />
                                            <Span FontAttributes="Bold" Text="{Binding Chofer}" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>

                                <!--  3: Pasajeros (Esperados vs Reales)  -->
                                <Grid
                                    Grid.Row="3"
                                    ColumnDefinitions="*,*"
                                    ColumnSpacing="10">
                                    <VerticalStackLayout Grid.Column="0">
                                        <Label
                                            FontSize="11"
                                            Text="👥 Esperados:"
                                            TextColor="Gray" />
                                        <Label
                                            FontAttributes="Bold"
                                            FontSize="15"
                                            Text="{Binding CantidadEsperada}" />
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="1">
                                        <Label
                                            FontSize="11"
                                            Text="✅ Reales:"
                                            TextColor="Gray" />
                                        <!--  RECUPERADO: Lógica para mostrar "No validado"  -->
                                        <Label
                                            FontAttributes="Bold"
                                            FontSize="15"
                                            IsVisible="{Binding CantidadReal, Converter={StaticResource IntToBoolConverter}}"
                                            Text="{Binding CantidadReal}" />
                                        <Label
                                            FontSize="12"
                                            IsVisible="{Binding CantidadReal, Converter={StaticResource InverseIntToBoolConverter}}"
                                            Text="No validado"
                                            TextColor="LightGray" />
                                    </VerticalStackLayout>
                                </Grid>

                                <!--  4: Tipo y Duración  -->
                                <Grid
                                    Grid.Row="4"
                                    ColumnDefinitions="*,*"
                                    ColumnSpacing="10">
                                    <Label Grid.Column="0" FontSize="12">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="📋 Tipo: " TextColor="Gray" />
                                                <Span Text="{Binding TipoFlete}" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                    <Label Grid.Column="1" FontSize="12">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="⏱️ Duración: " TextColor="Gray" />
                                                <Span Text="{Binding DuracionViaje}" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                </Grid>

                                <!--  5: Separador  -->
                                <BoxView
                                    Grid.Row="5"
                                    Margin="0,4"
                                    BackgroundColor="#E0E0E0"
                                    HeightRequest="1" />

                                <!--  6/7: Botones de Acción (4 botones como la vieja versión)  -->
                                <Grid
                                    Grid.Row="6"
                                    Grid.RowSpan="2"
                                    ColumnDefinitions="*,*,*,*"
                                    ColumnSpacing="6"
                                    VerticalOptions="Center">

                                    <Button
                                        Grid.Column="0"
                                        BackgroundColor="#E3F2FD"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.VerDetalleFleteCommand}"
                                        CommandParameter="{Binding .}"
                                        Style="{StaticResource ActionFlatButton}"
                                        Text="📋 Detalle"
                                        TextColor="#1976D2" />

                                    <Button
                                        Grid.Column="1"
                                        BackgroundColor="#E8F5E9"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.ReanudarFleteCommand}"
                                        CommandParameter="{Binding .}"
                                        IsVisible="{Binding EsPendiente}"
                                        Style="{StaticResource ActionFlatButton}"
                                        Text="🔄 Reanudar"
                                        TextColor="#2E7D32" />

                                    <Button
                                        Grid.Column="2"
                                        BackgroundColor="#FFF3E0"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.ValidarYFinalizarFleteCommand}"
                                        CommandParameter="{Binding .}"
                                        IsVisible="{Binding EsPendiente}"
                                        Style="{StaticResource ActionFlatButton}"
                                        Text="✅ Finalizar"
                                        TextColor="#E65100" />

                                    <Button
                                        Grid.Column="3"
                                        BackgroundColor="#FFEBEE"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.CancelarFleteCommand}"
                                        CommandParameter="{Binding .}"
                                        IsVisible="{Binding EsPendiente}"
                                        Style="{StaticResource ActionFlatButton}"
                                        Text="❌ Cancelar"
                                        TextColor="#C62828" />
                                </Grid>

                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

        <!--  ════════════ FILA 5: FOOTER ════════════  -->
        <Border
            Grid.Row="4"
            BackgroundColor="{AppThemeBinding Light=#E3F2FD,
                                              Dark=#1A237E}"
            Style="{StaticResource CardBorder}">
            <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                <Label
                    Grid.Column="0"
                    FontAttributes="Bold"
                    FontSize="13"
                    Text="{Binding FletesPendientes.Count, StringFormat='Total: {0} fletes'}"
                    TextColor="{AppThemeBinding Light=#1565C0,
                                                Dark=#BBDEFB}"
                    VerticalOptions="Center" />
                <Button
                    Grid.Column="1"
                    Padding="15,8"
                    BackgroundColor="#BBDEFB"
                    Command="{Binding SincronizarCommand}"
                    CornerRadius="20"
                    FontAttributes="Bold"
                    FontSize="13"
                    Text="🔄 Sincronizar"
                    TextColor="#0D47A1" />
            </Grid>
        </Border>

        <!--  ActivityIndicator  -->
        <ActivityIndicator
            Grid.RowSpan="5"
            HorizontalOptions="Center"
            IsRunning="{Binding EstaCargando}"
            IsVisible="{Binding EstaCargando}"
            Scale="1.5"
            VerticalOptions="Center"
            Color="#2196F3" />


    </Grid>
</ContentPage>