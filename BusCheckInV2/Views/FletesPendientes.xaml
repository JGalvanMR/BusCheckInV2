<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:BusCheckInV2.ViewModels"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:converters="clr-namespace:BusCheckInV2.Converters"
             x:Class="BusCheckInV2.Views.FletesPendientes"
             Title="Fletes Pendientes">

    <!--  NO establezcas BindingContext aquí, se hará en el code-behind  -->

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:StatusToActionConverter x:Key="StatusToActionConverter" />
            <converters:InverseIntToBoolConverter x:Key="InverseIntToBoolConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <!--  Agregar ToolbarItem para regresar  -->
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="⬅️ Volver"
                     Command="{Binding VolverCommand}"
                     Order="Primary"
                     Priority="0" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto,Auto,*,Auto">

        <!--  Cabecera  -->
        <Frame Grid.Row="0"
               Margin="10"
               Padding="15"
               CornerRadius="10"
               BackgroundColor="#2196F3">
            <VerticalStackLayout>
                <Label Text="🚚 Fletes Pendientes"
                       FontSize="20"
                       FontAttributes="Bold"
                       TextColor="White"
                       HorizontalOptions="Center" />
                <Label Text="{Binding VersionText}"
                       FontSize="12"
                       TextColor="White"
                       HorizontalOptions="Center" />
            </VerticalStackLayout>
        </Frame>

        <Frame Grid.Row="0"
               Margin="10,10,10,5"
               Padding="10"
               CornerRadius="10"
               BackgroundColor="{Binding ColorEstadoConexion, Converter={StaticResource ColorToLightConverter}}">
            <HorizontalStackLayout Spacing="10">
                <Label Text="🌐"
                       FontSize="16"
                       VerticalOptions="Center" />
                <Label Text="{Binding TextoEstadoConexion}"
                       FontSize="14"
                       FontAttributes="Bold"
                       VerticalOptions="Center" />
                <Label Text="{Binding MensajeEstado}"
                       FontSize="12"
                       TextColor="Gray"
                       VerticalOptions="Center"
                       HorizontalOptions="EndAndExpand" />

                <Button Padding="5"
                        Text="🔁"
                        Command="{Binding ProbarConexionComando}"
                        BackgroundColor="Transparent"
                        TextColor="{Binding ColorEstadoConexion}"
                        FontSize="16" />
            </HorizontalStackLayout>
        </Frame>

        <!--  Selector de Chofer  -->
        <Frame Grid.Row="1"
               Margin="10,5"
               Padding="15"
               CornerRadius="10"
               BackgroundColor="White">
            <VerticalStackLayout Spacing="10">
                <Label Text="Seleccionar Chofer:"
                       FontSize="16"
                       FontAttributes="Bold" />

                <Picker Title="👤 Elige tu nombre"
                        ItemsSource="{Binding ListaChoferes}"
                        SelectedItem="{Binding ChoferSeleccionado, Mode=TwoWay}"
                        BackgroundColor="White">
                    <Picker.Behaviors>
                        <toolkit:EventToCommandBehavior EventName="SelectedIndexChanged" Command="{Binding CargarFletesComando}" />
                    </Picker.Behaviors>
                </Picker>

                <Label Text="{Binding MensajeEstado}"
                       FontSize="12"
                       TextColor="Gray" />
            </VerticalStackLayout>
        </Frame>

        <!--  Filtros  -->
        <Frame Grid.Row="2"
               Margin="10,0,10,10"
               Padding="15"
               CornerRadius="10"
               BackgroundColor="White">
            <VerticalStackLayout Spacing="10">
                <Label Text="Filtros:"
                       FontSize="14"
                       FontAttributes="Bold" />

                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <VerticalStackLayout Grid.Column="0">
                        <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                            <Switch IsToggled="{Binding MostrarSoloPendientes, Mode=TwoWay}" OnColor="#4CAF50" />
                            <Label Text="Mostrar solo pendientes"
                                   FontSize="12"
                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>

                        <Label Margin="0,5,0,0"
                               Text="{Binding DiasFiltro, StringFormat='Mostrando fletes de los últimos {0} días'}"
                               FontSize="11"
                               TextColor="Gray" />
                    </VerticalStackLayout>

                    <Button Grid.Column="1"
                            Padding="10"
                            Text="🔄"
                            Command="{Binding CargarFletesComando}"
                            BackgroundColor="LightGray"
                            CornerRadius="8"
                            VerticalOptions="Center" />
                </Grid>
            </VerticalStackLayout>
        </Frame>

        <!--  Indicador de carga  -->
        <ActivityIndicator Grid.Row="3"
                           IsRunning="{Binding EstaCargando}"
                           IsVisible="{Binding EstaCargando}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />

        <!--  Lista de Fletes  -->
        <RefreshView Grid.Row="4"
                     Command="{Binding CargarFletesComando}"
                     IsRefreshing="{Binding EstaCargando}">

            <CollectionView ItemsSource="{Binding FletesPendientes}" SelectionMode="None">

                <CollectionView.EmptyView>
                    <VerticalStackLayout Padding="40"
                                         HorizontalOptions="Center"
                                         VerticalOptions="Center"
                                         Spacing="20">
                        <Label Text="📭"
                               FontSize="40"
                               HorizontalOptions="Center" />
                        <Label Text="No se encontraron fletes pendientes"
                               FontSize="16"
                               HorizontalOptions="Center" />
                        <Label Text="Seleccione otro chofer o ajuste los filtros"
                               FontSize="12"
                               TextColor="Gray"
                               HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame Margin="10,5"
                               Padding="15"
                               CornerRadius="10"
                               BackgroundColor="White"
                               HasShadow="True">

                            <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="8">

                                <!--  Cabecera con Ruta y Estado  -->
                                <Grid Row="0" ColumnDefinitions="*,Auto">
                                    <VerticalStackLayout Grid.Column="0">
                                        <Label Text="{Binding Ruta}"
                                               FontSize="16"
                                               FontAttributes="Bold"
                                               LineBreakMode="WordWrap" />
                                        <Label Text="{Binding FechaHora, StringFormat='{0:dd/MM/yyyy HH:mm}'}"
                                               FontSize="12"
                                               TextColor="Gray" />
                                    </VerticalStackLayout>

                                    <!--  Badge de Estado  -->
                                    <Frame Grid.Column="1"
                                           Padding="8,4"
                                           CornerRadius="12"
                                           BackgroundColor="{Binding Estatus, Converter={StaticResource StatusToColorConverter}}">
                                        <Label Text="{Binding Estatus}"
                                               FontSize="11"
                                               TextColor="White"
                                               FontAttributes="Bold" />
                                    </Frame>
                                </Grid>

                                <!--  Separador  -->
                                <BoxView Grid.Row="1"
                                         Margin="0,5"
                                         HeightRequest="1"
                                         BackgroundColor="#E0E0E0" />

                                <!--  Información del Chofer  -->
                                <VerticalStackLayout Grid.Row="2" Spacing="4">
                                    <Label Text="👤 Chofer:"
                                           FontSize="12"
                                           TextColor="Gray" />
                                    <Label Text="{Binding Chofer}" FontSize="14" />
                                </VerticalStackLayout>

                                <!--  Pasajeros  -->
                                <Grid Grid.Row="3"
                                      ColumnDefinitions="*,*"
                                      ColumnSpacing="10">
                                    <VerticalStackLayout Grid.Column="0" Spacing="4">
                                        <Label Text="👥 Esperados:"
                                               FontSize="12"
                                               TextColor="Gray" />
                                        <Label Text="{Binding CantidadEsperada, StringFormat='{0}'}"
                                               FontSize="14"
                                               FontAttributes="Bold" />
                                    </VerticalStackLayout>

                                    <VerticalStackLayout Grid.Column="1" Spacing="4">
                                        <Label Text="✅ Reales:"
                                               FontSize="12"
                                               TextColor="Gray" />
                                        <Label Text="{Binding CantidadReal, StringFormat='{0}'}"
                                               FontSize="14"
                                               FontAttributes="Bold"
                                               IsVisible="{Binding CantidadReal, Converter={StaticResource IntToBoolConverter}}" />
                                        <Label Text="No validado"
                                               FontSize="12"
                                               TextColor="LightGray"
                                               IsVisible="{Binding CantidadReal, Converter={StaticResource InverseIntToBoolConverter}}" />
                                    </VerticalStackLayout>
                                </Grid>

                                <!--  Tipo y Duración  -->
                                <Grid Grid.Row="4"
                                      ColumnDefinitions="*,*"
                                      ColumnSpacing="10">
                                    <VerticalStackLayout Grid.Column="0" Spacing="4">
                                        <Label Text="📋 Tipo:"
                                               FontSize="12"
                                               TextColor="Gray" />
                                        <Label Text="{Binding TipoFlete}" FontSize="12" />
                                    </VerticalStackLayout>

                                    <VerticalStackLayout Grid.Column="1" Spacing="4">
                                        <Label Text="⏱️ Duración:"
                                               FontSize="12"
                                               TextColor="Gray" />
                                        <Label Text="{Binding DuracionViaje}" FontSize="12" />
                                    </VerticalStackLayout>
                                </Grid>

                                <!--  Separador  -->
                                <BoxView Grid.Row="5"
                                         Margin="0,10"
                                         HeightRequest="1"
                                         BackgroundColor="#E0E0E0" />

                                <!--  Botones de Acción  -->
                                <Grid Grid.Row="6"
                                      ColumnDefinitions="*,*,*,*"
                                      ColumnSpacing="5"
                                      HorizontalOptions="Fill">

                                    <!--  Ver Detalle  -->
                                    <Button Grid.Column="0"
                                            Text="📋"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.VerDetalleComando}"
                                            CommandParameter="{Binding .}"
                                            BackgroundColor="#2196F3"
                                            TextColor="White"
                                            CornerRadius="8"
                                            FontSize="12" />

                                    <!--  Reanudar/Iniciar  -->
                                    <Button Grid.Column="1"
                                            Text="{Binding Estatus, Converter={StaticResource StatusToActionConverter}}"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.ReanudarFleteComando}"
                                            CommandParameter="{Binding .}"
                                            BackgroundColor="#4CAF50"
                                            TextColor="White"
                                            CornerRadius="8"
                                            FontSize="12"
                                            IsVisible="{Binding EsPendiente}" />

                                    <!--  Finalizar  -->
                                    <Button Grid.Column="2"
                                            Text="✅"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.ValidarYFinalizarComando}"
                                            CommandParameter="{Binding .}"
                                            BackgroundColor="#FF9800"
                                            TextColor="White"
                                            CornerRadius="8"
                                            FontSize="12"
                                            IsVisible="{Binding EsPendiente}" />

                                    <!--  Cancelar  -->
                                    <Button Grid.Column="3"
                                            Text="❌"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.CancelarFleteComando}"
                                            CommandParameter="{Binding .}"
                                            BackgroundColor="#F44336"
                                            TextColor="White"
                                            CornerRadius="8"
                                            FontSize="12"
                                            IsVisible="{Binding EsPendiente}" />
                                </Grid>
                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

        <!--  Footer  -->
        <Frame Grid.Row="7"
               Margin="10"
               Padding="10"
               CornerRadius="10"
               BackgroundColor="#E3F2FD">
            <Grid ColumnDefinitions="*,Auto">
                <Label Grid.Column="0"
                       Text="{Binding FletesPendientes.Count, StringFormat='Total: {0} fletes'}"
                       FontSize="12"
                       VerticalOptions="Center" />

                <Button Grid.Column="1"
                        Padding="10,5"
                        Text="🔄 Sincronizar"
                        Command="{Binding SincronizarConServidorComando}"
                        BackgroundColor="LightGray"
                        CornerRadius="8"
                        FontSize="12" />
            </Grid>
        </Frame>

    </Grid>
</ContentPage>