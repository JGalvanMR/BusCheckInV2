<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:BusCheckInV2.ViewModels"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:converters="clr-namespace:BusCheckInV2.Converters"
             xmlns:helpers="clr-namespace:BusCheckInV2.Helpers"
             x:Class="BusCheckInV2.Views.FletesPendientes"
             Title="Fletes Pendientes"
             Shell.NavBarIsVisible="True"
             BackgroundColor="{AppThemeBinding Light=#F5F7FA,
                                               Dark=#121212}">

    <!--  ===================== RESOURCES =====================  -->
    <ContentPage.Resources>
        <ResourceDictionary>

            <!--  Converters (SIN CAMBIOS)  -->
            <converters:StatusToColorConverter x:Key="StatusToColorConverter" />
            <converters:IntToBoolConverter x:Key="IntToBoolConverter" />
            <converters:InverseIntToBoolConverter x:Key="InverseIntToBoolConverter" />

            <!--  ===================== STYLES =====================  -->

            <Style x:Key="PageTitle" TargetType="Label">
                <Setter Property="FontSize" Value="22" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="{AppThemeBinding Light=#212121, Dark=White}" />
            </Style>

            <Style x:Key="CardBorder" TargetType="Border">
                <Setter Property="Padding" Value="12" />
                <Setter Property="Margin" Value="8,4" />
                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=White, Dark=#1E1E1E}" />
                <Setter Property="StrokeThickness" Value="0" />
                <Setter Property="StrokeShape">
                    <Setter.Value>
                        <RoundRectangle CornerRadius="14" />
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="PrimaryButton" TargetType="Button">
                <Setter Property="CornerRadius" Value="20" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Padding" Value="14,10" />
                <Setter Property="TextColor" Value="White" />
                <Setter Property="BackgroundColor" Value="#2196F3" />
            </Style>

            <Style x:Key="TonalButton" TargetType="Button">
                <Setter Property="CornerRadius" Value="20" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Padding" Value="7,5" />
                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#E3F2FD, Dark=#263238}" />
                <Setter Property="TextColor" Value="{AppThemeBinding Light=#0D47A1, Dark=#BBDEFB}" />
            </Style>

        </ResourceDictionary>
    </ContentPage.Resources>

    <!--  ===================== TOOLBAR =====================  -->
    <Shell.BackButtonBehavior>
        <BackButtonBehavior IsVisible="False" IsEnabled="False" />
    </Shell.BackButtonBehavior>
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Volver"
                     Command="{Binding VolverCommand}"
                     Order="Primary"
                     Priority="0">
            <ToolbarItem.IconImageSource>
                <FontImageSource Glyph="{x:Static helpers:IconFont.ArrowLeft}"
                                 FontFamily="FontAwesome"
                                 Size="24"
                                 Color="{AppThemeBinding Light=#212121,
                                                         Dark=White}" />
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
    </ContentPage.ToolbarItems>

    <!--  ===================== LAYOUT ROOT =====================  -->
    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
        <!--  ===================== HEADER =====================  -->
        <!--  ===================== FILTERS =====================  -->
        <VerticalStackLayout Grid.Row="0"
                             Padding="0"
                             Spacing="8">

            <Border Padding="12" Style="{StaticResource CardBorder}">
                <Border.Shadow>
                    <Shadow Radius="12"
                            Opacity="0.18"
                            Offset="0,4" />
                </Border.Shadow>
                <Grid RowDefinitions="Auto,Auto,Auto,Auto"
                      ColumnDefinitions="Auto,*"
                      RowSpacing="6"
                      ColumnSpacing="8">
                    <!--  Chofer + Estado (misma fila)  -->
                    <Label Grid.Row="0"
                           Grid.Column="0"
                           Text="Chofer"
                           FontSize="14"
                           FontAttributes="Bold" />
                    <Label Grid.Row="0"
                           Grid.Column="1"
                           Text="{Binding TextoEstadoConexion}"
                           TextColor="{Binding ColorEstadoConexion}"
                           FontSize="11"
                           HorizontalTextAlignment="End" />
                    <!--  Picker compacto  -->
                    <Picker Title="Nombre"
                            Grid.Row="1"
                            Grid.Column="0"
                            Grid.ColumnSpan="2"
                            HeightRequest="44"
                            ItemsSource="{Binding ListaUsuarios}"
                            SelectedItem="{Binding UsuarioSeleccionado}"
                            ItemDisplayBinding="{Binding Nombre}" />
                    <HorizontalStackLayout Grid.Row="2"
                                           Grid.Column="0"
                                           Grid.ColumnSpan="2"
                                           Spacing="10"
                                           VerticalOptions="Center">
                        <!--  Switch + texto  -->
                        <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                            <Switch IsToggled="{Binding MostrarSoloPendientes}" Scale="0.9" />
                            <Label Text="Solo pendientes"
                                   FontSize="12"
                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        <!--  Info secundaria  -->
                        <Label Text="{Binding DiasFiltro, StringFormat='Últimos {0} días'}"
                               FontSize="11"
                               TextColor="Gray"
                               VerticalOptions="Center" />
                    </HorizontalStackLayout>

                    <Grid Grid.Row="3"
                          Grid.Column="0"
                          Grid.ColumnSpan="2"
                          ColumnDefinitions="*,Auto"
                          VerticalOptions="Center">

                        <Button Padding="12,0"
                                Text="Actualizar"
                                Command="{Binding CargarFletesComando}"
                                HeightRequest="44"
                                FontSize="13"
                                Style="{StaticResource TonalButton}" />
                    </Grid>

                </Grid>
            </Border>

        </VerticalStackLayout>


        <!--  Mensaje de estado  -->
        <Label Grid.Row="2"
               Margin="10,5"
               Text="{Binding MensajeEstado}"
               FontSize="12"
               TextColor="Gray"
               HorizontalOptions="Center"
               VerticalOptions="Start" />

        <!--  Lista de Fletes (OCCUPA TODO EL ESPACIO RESTANTE)  -->
        <RefreshView Grid.Row="3"
                     Command="{Binding CargarFletesComando}"
                     IsRefreshing="{Binding EstaCargando}">

            <CollectionView ItemsSource="{Binding FletesPendientes}" SelectionMode="None">

                <CollectionView.EmptyView>
                    <VerticalStackLayout Padding="40"
                                         HorizontalOptions="Center"
                                         VerticalOptions="Center"
                                         Spacing="20">
                        <Label Text="📭"
                               FontSize="40"
                               HorizontalOptions="Center" />
                        <Label Text="{Binding MensajeEstado}"
                               FontSize="16"
                               HorizontalOptions="Center"
                               TextColor="Gray" />
                        <Label Text="Seleccione un chofer para comenzar"
                               FontSize="12"
                               TextColor="LightGray"
                               HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardBorder}">
                            <Border.Shadow>
                                <Shadow Radius="8"
                                        Opacity="0.12"
                                        Offset="0,2" />
                            </Border.Shadow>

                            <Grid RowDefinitions="Auto,Auto,Auto"
                                  RowSpacing="8"
                                  ColumnDefinitions="*,Auto">

                                <!--  Fila 1: Ruta y Fecha  -->
                                <VerticalStackLayout Grid.Row="0" Grid.Column="0">
                                    <Label Text="{Binding Ruta}"
                                           FontSize="16"
                                           FontAttributes="Bold"
                                           LineBreakMode="WordWrap" />
                                    <Label Text="{Binding FechaHora, StringFormat='{0:dd/MM/yyyy HH:mm}'}"
                                           FontSize="12"
                                           TextColor="Gray" />
                                </VerticalStackLayout>
                                <Grid Grid.Row="0"
                                      Grid.Column="1"
                                      ColumnDefinitions="Auto,Auto">
                                    <Label Grid.Column="0"
                                           Text="👥  "
                                           FontSize="16"
                                           TextColor="Gray"
                                           FontAttributes="Bold" />
                                    <Label Grid.Column="1"
                                           Text="{Binding CantidadEsperada}"
                                           FontSize="16"
                                           FontAttributes="Bold" />
                                </Grid>

                                <!--  Fila 2: Chofer y Estado  -->
                                <Grid Grid.Row="1"
                                      Grid.ColumnSpan="2"
                                      ColumnDefinitions="*,Auto">
                                    <Label Grid.Column="0"
                                           Text="{Binding Chofer}"
                                           FontSize="14" />
                                    <Border Grid.Column="1"
                                            Padding="8,4"
                                            BackgroundColor="{Binding Estatus, Converter={StaticResource StatusToColorConverter}}">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="16" />
                                        </Border.StrokeShape>
                                        <Border.Shadow>
                                            <Shadow Radius="12"
                                                    Opacity="0.18"
                                                    Offset="0,4" />
                                        </Border.Shadow>
                                        <Label Text="{Binding Estatus}"
                                               FontSize="11"
                                               TextColor="White"
                                               FontAttributes="Bold" />
                                    </Border>
                                </Grid>

                                <!--  Fila 3: Botones  -->
                                <Grid Grid.Row="2"
                                      Grid.ColumnSpan="2"
                                      ColumnDefinitions="*,*"
                                      ColumnSpacing="5">
                                    <Button Grid.Column="0"
                                            Text="Detalle"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.VerDetalleComando}"
                                            CommandParameter="{Binding .}"
                                            BackgroundColor="Transparent"
                                            TextColor="#2196F3"
                                            CornerRadius="20" />

                                    <Button Grid.Column="1"
                                            Text="Finalizar"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.ValidarYFinalizarComando}"
                                            CommandParameter="{Binding .}"
                                            BackgroundColor="#4CAF50"
                                            TextColor="White"
                                            CornerRadius="20"
                                            IsVisible="{Binding EsPendiente}" />
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>



        <!--  ===================== FOOTER =====================  -->
        <Border Grid.Row="4" Style="{StaticResource CardBorder}">

            <!--  Sombra más ligera o opcional  -->
            <Border.Shadow>
                <Shadow Radius="8"
                        Opacity="0.12"
                        Offset="0,2" />
            </Border.Shadow>

            <Grid ColumnDefinitions="Auto,*"
                  ColumnSpacing="8"
                  VerticalOptions="Center">

                <!--  Info secundaria  -->
                <Label Text="{Binding FletesPendientes.Count, StringFormat='{0} fletes'}"
                       FontSize="13"
                       TextColor="Gray"
                       VerticalOptions="Center" />

                <!--  Acción  -->
                <Button Grid.Column="1"
                        Text="Sincronizar"
                        Command="{Binding SincronizarComando}"
                        Style="{StaticResource TonalButton}" />
            </Grid>
        </Border>


        <!--  ActivityIndicator  -->
        <ActivityIndicator Grid.RowSpan="5"
                           IsRunning="{Binding EstaCargando}"
                           IsVisible="{Binding EstaCargando}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           Scale="1.6"
                           Color="#2196F3" />
    </Grid>
</ContentPage>